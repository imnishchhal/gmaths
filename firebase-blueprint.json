      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Trusted administrator membership registry."
    },
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/AgentProfile" },
      "description": "Field / Sales Agents managed by Admin for onboarding, referrals, and commission payouts."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCodePublic" },
      "description": "Zero-PII public referral promo lookup documents."
    },
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/ParentProfile" },
      "description": "Parent accounts onboarded by field Agents."
    },
    "/children/{childId}": {
      "schema": { "$ref": "#/entities/ChildProfile" },
