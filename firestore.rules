rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net — default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3;
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && userEmailLower() == 'kumarnishchhal175@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAgentRecordAuthorized(data) {
      return isVerifiedUser() && (
        data.ownerUid == request.auth.uid
        || (isBootstrappedAdmin() && data.workspaceId == 'gmaths_main')
        || (data.email is string && data.email.size() >= 3 && data.email == userEmailLower())
      );
    }

    function isParentRecordAuthorized(data) {
      return isVerifiedUser() && (
        data.ownerUid == request.auth.uid
        || (isBootstrappedAdmin() && data.workspaceId == 'gmaths_main')
        || (data.agentEmail is string && data.agentEmail.size() >= 3 && data.agentEmail == userEmailLower())
        || (data.email is string && data.email.size() >= 3 && data.email == userEmailLower())
      );
    }

    function isFamilyScopedAuthorized(data) {
      return isVerifiedUser() && (
        data.ownerUid == request.auth.uid
        || (isBootstrappedAdmin() && data.workspaceId == 'gmaths_main')
        || (data.agentEmail is string && data.agentEmail.size() >= 3 && data.agentEmail == userEmailLower())
        || (data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail == userEmailLower())
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMode(mode) {
      return mode is string && mode in ['addition', 'subtraction', 'multiplication', 'division', 'mixed'];
    }

    function isValidTopic(topic) {
      return topic is string && topic in ['none', 'addition', 'subtraction', 'multiplication', 'division'];
    }

    function isValidDifficulty(difficulty) {
      return difficulty is string && difficulty in ['easy', 'medium', 'hard'];
    }

    function isValidSessionType(sessionType) {
      return sessionType is string && sessionType in ['sprint', 'streak', 'practice'];
    }

    function isValidIndianClass(grade) {
      return grade is string && grade in [
        'Nursery', 'LKG', 'UKG',
        '1st', '2nd', '3rd', '4th', '5th', '6th',
        '7th', '8th', '9th', '10th', '11th', '12th'
      ];
    }

    function isValidPaymentMethod(method) {
      return method is string && method in ['cash', 'upi', 'bank'];
    }

    function isValidStudentPaymentMethod(method) {
      return method is string && method in ['upi', 'card', 'voucher'];
    }

    function isValidSubscriptionStatus(status) {
      return status is string && status in ['active', 'expired', 'suspended'];
    }

    function isValidApprovalStatus(status) {
      return status is string && status in ['pending', 'approved', 'suspended'];
    }

    // -------------------------------------------------------------------------
    // Standalone Validation Blueprints (synchronized with firebase-blueprint.json)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSessionRecord(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'userId', 'mode', 'difficulty', 'sessionType',
          'durationSec', 'elapsedSec', 'score', 'attempted', 'correct',
          'accuracy', 'bestStreak', 'avgResponseMs', 'qpm', 'allowNegatives', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'mode', 'difficulty', 'sessionType',
          'durationSec', 'elapsedSec', 'score', 'attempted', 'correct',
          'accuracy', 'bestStreak', 'avgResponseMs', 'qpm', 'allowNegatives', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == sessionId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && isValidMode(data.mode)
        && isValidDifficulty(data.difficulty)
        && isValidSessionType(data.sessionType)
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 3600
        && (data.elapsedSec is int || data.elapsedSec is float) && data.elapsedSec >= 0 && data.elapsedSec <= 7200
        && data.score is int && data.score >= 0 && data.score <= 5000
        && data.attempted is int && data.attempted >= 0 && data.attempted <= 10000
        && data.correct is int && data.correct == data.score && data.correct <= data.attempted
        && (data.accuracy is int || data.accuracy is float) && data.accuracy >= 0 && data.accuracy <= 100
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= data.score
        && data.avgResponseMs is int && data.avgResponseMs >= 0 && data.avgResponseMs <= 600000
        && (data.qpm is int || data.qpm is float) && data.qpm >= 0 && data.qpm <= 600
        && data.allowNegatives is bool
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll([
          'id', 'userId', 'displayName', 'mode', 'difficulty', 'sessionType',
          'durationSec', 'score', 'accuracy', 'bestStreak', 'avgResponseMs',
          'qpm', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'displayName', 'mode', 'difficulty', 'sessionType',
          'durationSec', 'score', 'accuracy', 'bestStreak', 'avgResponseMs',
          'qpm', 'isPublic', 'isHidden', 'isFlagged', 'flagReason', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.userId)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && isValidMode(data.mode)
        && isValidDifficulty(data.difficulty)
        && isValidSessionType(data.sessionType)
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 3600
        && data.id == (data.userId + '_' + data.mode + '_' + data.difficulty + '_' + data.sessionType + '_' + string(data.durationSec))
        && data.score is int && data.score >= 1 && data.score <= 5000
        && (data.accuracy is int || data.accuracy is float) && data.accuracy >= 0 && data.accuracy <= 100
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= data.score
        && data.avgResponseMs is int && data.avgResponseMs >= 0 && data.avgResponseMs <= 600000
        && (data.qpm is int || data.qpm is float) && data.qpm >= 0 && data.qpm <= 600
        && data.isPublic is bool && data.isPublic == true
        && (!('isHidden' in data) || data.isHidden is bool)
        && (!('isFlagged' in data) || data.isFlagged is bool)
        && (!('flagReason' in data) || (data.flagReason is string && data.flagReason.size() <= 160))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidAgentProfile(data, agentId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'agentCode', 'name', 'phone', 'email',
          'assignedArea', 'commissionRate', 'defaultYearlyFee', 'passcodeHash',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'agentCode', 'name', 'phone', 'email',
          'assignedArea', 'city', 'upiId', 'approvalStatus',
          'commissionRate', 'commissionPerConversion', 'defaultYearlyFee', 'passcodeHash',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == agentId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.agentCode is string && data.agentCode.size() >= 2 && data.agentCode.size() <= 32 && data.agentCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.assignedArea is string && data.assignedArea.size() >= 1 && data.assignedArea.size() <= 80
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100))
        && (!('approvalStatus' in data) || isValidApprovalStatus(data.approvalStatus))
        && (data.commissionRate is int || data.commissionRate is float) && data.commissionRate >= 0 && data.commissionRate <= 100
        && (!('commissionPerConversion' in data) || ((data.commissionPerConversion is int || data.commissionPerConversion is float) && data.commissionPerConversion >= 0 && data.commissionPerConversion <= 10000))
        && (data.defaultYearlyFee is int || data.defaultYearlyFee is float) && data.defaultYearlyFee >= 0 && data.defaultYearlyFee <= 1000000
        && data.passcodeHash is string && data.passcodeHash.size() >= 16 && data.passcodeHash.size() <= 128
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralCodePublic(data, code) {
      return data.keys().hasAll([
          'code', 'workspaceId', 'agentId', 'agentName', 'isActive',
          'approvalStatus', 'emailHash', 'phoneHash', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'workspaceId', 'agentId', 'agentName', 'isActive',
          'approvalStatus', 'emailHash', 'phoneHash', 'updatedAt'
        ])
        && isValidId(data.code) && data.code == code && data.code.size() >= 2 && data.code.size() <= 32
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.agentId)
        && data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 80
        && data.isActive is bool
        && isValidApprovalStatus(data.approvalStatus)
        && data.emailHash is string && data.emailHash.size() <= 128
        && data.phoneHash is string && data.phoneHash.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidParentProfile(data, parentId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'name', 'contact', 'email', 'passcodeHash',
          'createdByAgentId', 'agentEmail', 'agentName', 'agentPhone', 'agentArea', 'agentCode',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'name', 'contact', 'email', 'passcodeHash',
          'createdByAgentId', 'agentEmail', 'agentName', 'agentPhone', 'agentArea', 'agentCode',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == parentId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 120
        && data.email is string && data.email.size() <= 120
        && data.passcodeHash is string && data.passcodeHash.size() >= 16 && data.passcodeHash.size() <= 128
        && isValidId(data.createdByAgentId)
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 80
        && data.agentPhone is string && data.agentPhone.size() >= 3 && data.agentPhone.size() <= 40
        && data.agentArea is string && data.agentArea.size() >= 1 && data.agentArea.size() <= 80
        && data.agentCode is string && data.agentCode.size() >= 2 && data.agentCode.size() <= 32 && data.agentCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChildProfile(data, childId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'parentId', 'createdByAgentId',
          'parentEmail', 'agentEmail', 'name', 'grade', 'totalScore',
          'sessionsCount', 'bestStreak', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'parentId', 'createdByAgentId',
          'parentEmail', 'agentEmail', 'name', 'grade', 'totalScore',
          'sessionsCount', 'bestStreak', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == childId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && isValidId(data.parentId)
        && isValidId(data.createdByAgentId)
        && data.parentEmail is string && data.parentEmail.size() <= 120
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && isValidIndianClass(data.grade)
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 10000000
        && data.sessionsCount is int && data.sessionsCount >= 0 && data.sessionsCount <= 1000000
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChildLeaderboardEntry(data, childId) {
      return data.keys().hasAll([
          'id', 'childId', 'workspaceId', 'ownerUid', 'name', 'grade',
          'totalScore', 'sessionsCount', 'bestStreak', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'childId', 'workspaceId', 'ownerUid', 'name', 'grade',
          'totalScore', 'sessionsCount', 'bestStreak', 'isPublic', 'isHidden', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == childId
        && isValidId(data.childId) && data.childId == childId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && isValidIndianClass(data.grade)
        && data.totalScore is int && data.totalScore >= 1 && data.totalScore <= 10000000
        && data.sessionsCount is int && data.sessionsCount >= 1 && data.sessionsCount <= 1000000
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000
        && data.isPublic is bool && data.isPublic == true
        && (!('isHidden' in data) || data.isHidden is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscriptionRecord(data, subscriptionId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'parentId', 'parentEmail', 'agentEmail',
          'planType', 'startDate', 'expiryDate', 'feeAmount', 'paymentMethod',
          'receiptNote', 'collectedByAgentId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'parentId', 'parentEmail', 'agentEmail',
          'planType', 'startDate', 'expiryDate', 'feeAmount', 'paymentMethod',
          'receiptNote', 'collectedByAgentId', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == subscriptionId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && isValidId(data.parentId)
        && data.parentEmail is string && data.parentEmail.size() <= 120
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.planType is string && data.planType == 'yearly'
        && isValidDateString(data.startDate)
        && isValidDateString(data.expiryDate)
        && (data.feeAmount is int || data.feeAmount is float) && data.feeAmount >= 0 && data.feeAmount <= 1000000
        && isValidPaymentMethod(data.paymentMethod)
        && data.receiptNote is string && data.receiptNote.size() <= 160
        && isValidId(data.collectedByAgentId)
        && isValidSubscriptionStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrialLead(data, leadId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'name', 'email', 'phone',
          'referralCode', 'agentId', 'agentEmail', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'name', 'email', 'phone',
          'referralCode', 'agentId', 'agentEmail', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == leadId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.email is string && data.email.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.referralCode is string && data.referralCode.size() >= 2 && data.referralCode.size() <= 32
        && isValidId(data.agentId)
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.status is string && data.status in ['trial', 'converted']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentSubscription(data, subscriptionId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'subscriberName', 'subscriberEmail', 'subscriberPhone',
          'planType', 'startDate', 'expiryDate', 'amountPaid', 'discountApplied', 'paymentMethod',
          'referralCode', 'attributedAgentId', 'agentEmail', 'voucherCode', 'commissionAmount',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'subscriberName', 'subscriberEmail', 'subscriberPhone',
          'planType', 'startDate', 'expiryDate', 'amountPaid', 'discountApplied', 'paymentMethod',
          'referralCode', 'attributedAgentId', 'agentEmail', 'voucherCode', 'commissionAmount',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == subscriptionId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.subscriberName is string && data.subscriberName.size() >= 1 && data.subscriberName.size() <= 80
        && data.subscriberEmail is string && data.subscriberEmail.size() <= 120
        && data.subscriberPhone is string && data.subscriberPhone.size() <= 40
        && data.planType is string && data.planType == 'yearly'
        && isValidDateString(data.startDate)
        && isValidDateString(data.expiryDate)
        && (data.amountPaid is int || data.amountPaid is float) && data.amountPaid >= 0 && data.amountPaid <= 100000
        && (data.discountApplied is int || data.discountApplied is float) && data.discountApplied >= 0 && data.discountApplied <= 10000
        && isValidStudentPaymentMethod(data.paymentMethod)
        && data.referralCode is string && data.referralCode.size() <= 32
        && data.attributedAgentId is string && data.attributedAgentId.size() <= 128
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.voucherCode is string && data.voucherCode.size() <= 64
        && (data.commissionAmount is int || data.commissionAmount is float) && data.commissionAmount >= 0 && data.commissionAmount <= 10000
        && isValidSubscriptionStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayoutRequest(data, payoutId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'agentId', 'agentEmail', 'agentName',
          'upiId', 'amount', 'status', 'utrNumber', 'createdAt', 'updatedAt', 'paidAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'agentId', 'agentEmail', 'agentName',
          'upiId', 'amount', 'status', 'utrNumber', 'createdAt', 'updatedAt', 'paidAt'
        ])
        && isValidId(data.id) && data.id == payoutId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && isValidId(data.agentId)
        && data.agentEmail is string && data.agentEmail.size() >= 3 && data.agentEmail.size() <= 120
        && data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 80
        && data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 100
        && (data.amount is int || data.amount is float) && data.amount >= 500 && data.amount <= 1000000
        && data.status is string && data.status in ['pending', 'paid']
        && data.utrNumber is string && data.utrNumber.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.paidAt is string && data.paidAt.size() <= 32;
    }

    function isValidOfflineVoucher(data, voucherId) {
      return data.keys().hasAll([
          'id', 'code', 'workspaceId', 'ownerUid', 'agentId', 'agentEmail', 'agentName',
          'planAmount', 'status', 'redeemedByUid', 'redeemedByEmail', 'createdAt', 'redeemedAt'
        ])
        && data.keys().hasOnly([
          'id', 'code', 'workspaceId', 'ownerUid', 'agentId', 'agentEmail', 'agentName',
          'planAmount', 'status', 'redeemedByUid', 'redeemedByEmail', 'createdAt', 'redeemedAt'
        ])
        && isValidId(data.id) && data.id == voucherId && data.id.size() >= 4 && data.id.size() <= 64
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 64
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && data.agentId is string && data.agentId.size() <= 128
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && data.agentName is string && data.agentName.size() <= 80
        && (data.planAmount is int || data.planAmount is float) && data.planAmount >= 0 && data.planAmount <= 100000
        && data.status is string && data.status in ['unused', 'redeemed']
        && data.redeemedByUid is string && data.redeemedByUid.size() <= 128
        && data.redeemedByEmail is string && data.redeemedByEmail.size() <= 120
        && data.createdAt is timestamp
        && data.redeemedAt is string && data.redeemedAt.size() <= 32;
    }

    function isValidAppConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'dailyChallengeSeed', 'announcementEnabled', 'announcementText', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'dailyChallengeSeed', 'announcementEnabled', 'announcementText', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == configId && data.id.size() <= 64
        && data.dailyChallengeSeed is string && data.dailyChallengeSeed.size() >= 1 && data.dailyChallengeSeed.size() <= 64
        && data.announcementEnabled is bool
        && data.announcementText is string && data.announcementText.size() <= 240
        && data.updatedAt is timestamp;
    }

    function isValidPracticeSession(data, sessionId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'ownerUid', 'childId', 'parentId', 'parentEmail', 'agentEmail',
          'grade', 'mode', 'difficulty', 'sessionType', 'durationSec', 'elapsedSec',
          'score', 'attempted', 'correct', 'accuracy', 'bestStreak',
          'avgResponseMs', 'qpm', 'allowNegatives', 'weakTopic', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'ownerUid', 'childId', 'parentId', 'parentEmail', 'agentEmail',
          'grade', 'mode', 'difficulty', 'sessionType', 'durationSec', 'elapsedSec',
          'score', 'attempted', 'correct', 'accuracy', 'bestStreak',
          'avgResponseMs', 'qpm', 'allowNegatives', 'weakTopic', 'createdAt'
        ])
        && isValidId(data.id) && data.id == sessionId
        && isValidId(data.workspaceId) && data.workspaceId.size() <= 64
        && isValidId(data.ownerUid)
        && isValidId(data.childId)
        && isValidId(data.parentId)
        && data.parentEmail is string && data.parentEmail.size() <= 120
        && data.agentEmail is string && data.agentEmail.size() <= 120
        && isValidIndianClass(data.grade)
        && isValidMode(data.mode)
        && isValidDifficulty(data.difficulty)
        && isValidSessionType(data.sessionType)
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 3600
        && (data.elapsedSec is int || data.elapsedSec is float) && data.elapsedSec >= 0 && data.elapsedSec <= 7200
        && data.score is int && data.score >= 0 && data.score <= 5000
        && data.attempted is int && data.attempted >= 0 && data.attempted <= 10000
        && data.correct is int && data.correct == data.score && data.correct <= data.attempted
        && (data.accuracy is int || data.accuracy is float) && data.accuracy >= 0 && data.accuracy <= 100
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= data.score
        && data.avgResponseMs is int && data.avgResponseMs >= 0 && data.avgResponseMs <= 600000
        && (data.qpm is int || data.qpm is float) && data.qpm >= 0 && data.qpm <= 600
        && data.allowNegatives is bool
        && isValidTopic(data.weakTopic)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection 1: /users/{userId} — Private User Profile (PII Isolated)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);

      // -----------------------------------------------------------------------
      // Collection 2: /users/{userId}/sessions/{sessionId}
      // -----------------------------------------------------------------------
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidSessionRecord(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId);
      }
    }

    // -------------------------------------------------------------------------
    // Collection 3: /leaderboard/{entryId} — Public Non-PII Personal Bests
    // -------------------------------------------------------------------------
    match /leaderboard/{entryId} {
      allow get: if isSignedIn()
        && isValidId(entryId)
        && (resource == null || resource.data.isPublic == true);

      allow list: if isSignedIn()
        && resource.data.isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming(), entryId)
        && incoming().userId == request.auth.uid
        && (!('isHidden' in incoming()) || incoming().isHidden == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming(), entryId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().mode == existing().mode
        && incoming().difficulty == existing().difficulty
        && incoming().sessionType == existing().sessionType
        && incoming().durationSec == existing().durationSec
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['isHidden', 'isFlagged', 'flagReason', 'updatedAt'])
          )
          ||
          (
            existing().userId == request.auth.uid
            && (
              (
                (incoming().score > existing().score
                  || (incoming().score == existing().score && incoming().accuracy >= existing().accuracy))
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'score', 'accuracy', 'bestStreak', 'avgResponseMs',
                  'qpm', 'isFlagged', 'flagReason', 'updatedAt'
                ])
              )
              ||
              (
                incoming().score == existing().score
                && incoming().accuracy == existing().accuracy
                && incoming().bestStreak == existing().bestStreak
                && incoming().avgResponseMs == existing().avgResponseMs
                && incoming().qpm == existing().qpm
                && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
              )
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && (isAdmin() || existing().userId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 4: /admins/{userId} — Trusted Admin Registry
    // -------------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin()
        && isValidId(userId)
        && isValidAdminAccount(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // Collection 5: /agents/{agentId} — Field & Sales Agents
    // -------------------------------------------------------------------------
    match /agents/{agentId} {
      allow get: if isVerifiedUser()
        && isValidId(agentId)
        && (resource == null || isAgentRecordAuthorized(existing()));

      allow list: if isVerifiedUser()
        && isAgentRecordAuthorized(resource.data);

      allow create: if isVerifiedUser()
        && isValidId(agentId)
        && isValidAgentProfile(incoming(), agentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().ownerUid == request.auth.uid
            && incoming().email == userEmailLower()
            && 'approvalStatus' in incoming()
            && incoming().approvalStatus == 'pending'
            && incoming().isActive == false
            && incoming().commissionRate == 0
            && (!('commissionPerConversion' in incoming()) || incoming().commissionPerConversion == 0)
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(agentId)
        && isValidAgentProfile(incoming(), agentId)
        && isAgentRecordAuthorized(existing())
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'assignedArea', 'city', 'upiId', 'passcodeHash', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(agentId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 5b: /referralCodes/{code} — Public Non-PII Promo Directory
    // -------------------------------------------------------------------------
    match /referralCodes/{code} {
      allow get: if isValidId(code);
      allow list: if isAdmin();

      allow create, update: if isVerifiedUser()
        && isValidId(code)
        && isValidReferralCodePublic(incoming(), code)
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/agents/$(incoming().agentId))
            && isAgentRecordAuthorized(get(/databases/$(database)/documents/agents/$(incoming().agentId)).data)
            && incoming().isActive == get(/databases/$(database)/documents/agents/$(incoming().agentId)).data.isActive
          )
        );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection 6: /parents/{parentId} — Onboarded Parent Accounts
    // -------------------------------------------------------------------------
    match /parents/{parentId} {
      allow get: if isVerifiedUser()
        && isValidId(parentId)
        && (resource == null || isParentRecordAuthorized(existing()));

      allow list: if isVerifiedUser()
        && isParentRecordAuthorized(resource.data);

      allow create: if isVerifiedUser()
        && isValidId(parentId)
        && isValidParentProfile(incoming(), parentId)
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/agents/$(incoming().createdByAgentId))
        && (
          isAdmin()
          || isAgentRecordAuthorized(get(/databases/$(database)/documents/agents/$(incoming().createdByAgentId)).data)
        );

      allow update: if isVerifiedUser()
        && isValidId(parentId)
        && isValidParentProfile(incoming(), parentId)
        && isParentRecordAuthorized(existing())
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdByAgentId == existing().createdByAgentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'contact', 'email', 'passcodeHash',
            'agentEmail', 'agentName', 'agentPhone', 'agentArea', 'agentCode', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(parentId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 7: /children/{childId} — Credential-Free Linked Child Profiles
    // -------------------------------------------------------------------------
    match /children/{childId} {
      allow get: if isVerifiedUser()
        && isValidId(childId)
        && (resource == null || isFamilyScopedAuthorized(existing()));

      allow list: if isVerifiedUser()
        && isFamilyScopedAuthorized(resource.data);

      allow create: if isVerifiedUser()
        && isValidId(childId)
        && isValidChildProfile(incoming(), childId)
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/parents/$(incoming().parentId))
        && (
          isAdmin()
          || isParentRecordAuthorized(get(/databases/$(database)/documents/parents/$(incoming().parentId)).data)
        );

      allow update: if isVerifiedUser()
        && isValidId(childId)
        && isValidChildProfile(incoming(), childId)
        && isFamilyScopedAuthorized(existing())
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().parentId == existing().parentId
        && incoming().createdByAgentId == existing().createdByAgentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'grade', 'totalScore', 'sessionsCount', 'bestStreak', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(childId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 8: /childLeaderboard/{childId} — Public Non-PII Top Champions
    // -------------------------------------------------------------------------
    match /childLeaderboard/{childId} {
      allow get: if isValidId(childId)
        && (resource == null || resource.data.isPublic == true);

      allow list: if resource.data.totalScore >= 1;

      allow create: if isVerifiedUser()
        && isValidId(childId)
        && isValidChildLeaderboardEntry(incoming(), childId)
        && (!('isHidden' in incoming()) || incoming().isHidden == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/children/$(childId))
        && (isAdmin() || isFamilyScopedAuthorized(get(/databases/$(database)/documents/children/$(childId)).data));

      allow update: if isVerifiedUser()
        && isValidId(childId)
        && isValidChildLeaderboardEntry(incoming(), childId)
        && incoming().id == existing().id
        && incoming().childId == existing().childId
        && incoming().workspaceId == existing().workspaceId
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['isHidden', 'updatedAt'])
          )
          ||
          (
            exists(/databases/$(database)/documents/children/$(childId))
            && isFamilyScopedAuthorized(get(/databases/$(database)/documents/children/$(childId)).data)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'grade', 'totalScore', 'sessionsCount', 'bestStreak', 'ownerUid', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(childId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 9: /subscriptions/{subscriptionId} — Yearly Parent Ledger
    // -------------------------------------------------------------------------
    match /subscriptions/{subscriptionId} {
      allow get: if isVerifiedUser()
        && isValidId(subscriptionId)
        && (resource == null || isFamilyScopedAuthorized(existing()));

      allow list: if isVerifiedUser()
        && isFamilyScopedAuthorized(resource.data);

      allow create: if isVerifiedUser()
        && isValidId(subscriptionId)
        && isValidSubscriptionRecord(incoming(), subscriptionId)
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/parents/$(incoming().parentId))
        && exists(/databases/$(database)/documents/agents/$(incoming().collectedByAgentId))
        && (
          isAdmin()
          || (
            isParentRecordAuthorized(get(/databases/$(database)/documents/parents/$(incoming().parentId)).data)
            && isAgentRecordAuthorized(get(/databases/$(database)/documents/agents/$(incoming().collectedByAgentId)).data)
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(subscriptionId)
        && isValidSubscriptionRecord(incoming(), subscriptionId)
        && isFamilyScopedAuthorized(existing())
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().parentId == existing().parentId
        && incoming().planType == existing().planType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'startDate', 'expiryDate', 'feeAmount', 'paymentMethod',
            'receiptNote', 'collectedByAgentId', 'status', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(subscriptionId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Collection 10: /leads/{leadId} — Trial Signups & Agent Follow-ups
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      allow get: if isVerifiedUser()
        && isValidId(leadId)
        && (
          resource == null
          || isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow create: if isVerifiedUser()
        && isValidId(leadId)
        && isValidTrialLead(incoming(), leadId)
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/agents/$(incoming().agentId));

      allow update: if isVerifiedUser()
        && isValidId(leadId)
        && isValidTrialLead(incoming(), leadId)
        && (
          isAdmin()
          || existing().ownerUid == request.auth.uid
          || (existing().agentEmail is string && existing().agentEmail.size() >= 3 && existing().agentEmail == userEmailLower())
        )
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().agentId == existing().agentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidId(leadId);
    }

    // -------------------------------------------------------------------------
    // Collection 11: /studentSubscriptions/{subscriptionId} — Annual Pro Plans
    // -------------------------------------------------------------------------
    match /studentSubscriptions/{subscriptionId} {
      allow get: if isVerifiedUser()
        && isValidId(subscriptionId)
        && (
          resource == null
          || isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.subscriberEmail is string && resource.data.subscriberEmail.size() >= 3 && resource.data.subscriberEmail == userEmailLower())
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.subscriberEmail is string && resource.data.subscriberEmail.size() >= 3 && resource.data.subscriberEmail == userEmailLower())
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow create: if isVerifiedUser()
        && isValidId(subscriptionId)
        && isValidStudentSubscription(incoming(), subscriptionId)
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().attributedAgentId == ''
          || (
            exists(/databases/$(database)/documents/agents/$(incoming().attributedAgentId))
            && (
              isAdmin()
              || (
                get(/databases/$(database)/documents/agents/$(incoming().attributedAgentId)).data.ownerUid != request.auth.uid
                && get(/databases/$(database)/documents/agents/$(incoming().attributedAgentId)).data.email != userEmailLower()
                && incoming().commissionAmount <= 350
              )
            )
          )
        );

      allow update: if isAdmin()
        && isValidId(subscriptionId)
        && isValidStudentSubscription(incoming(), subscriptionId)
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(subscriptionId);
    }

    // -------------------------------------------------------------------------
    // Collection 12: /payoutRequests/{payoutId} — Agent UPI Withdrawals
    // -------------------------------------------------------------------------
    match /payoutRequests/{payoutId} {
      allow get: if isVerifiedUser()
        && isValidId(payoutId)
        && (
          resource == null
          || isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow create: if isVerifiedUser()
        && isValidId(payoutId)
        && isValidPayoutRequest(incoming(), payoutId)
        && incoming().status == 'pending'
        && incoming().utrNumber == ''
        && incoming().paidAt == ''
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/agents/$(incoming().agentId))
        && get(/databases/$(database)/documents/agents/$(incoming().agentId)).data.isActive == true
        && (
          !('approvalStatus' in get(/databases/$(database)/documents/agents/$(incoming().agentId)).data)
          || get(/databases/$(database)/documents/agents/$(incoming().agentId)).data.approvalStatus == 'approved'
        )
        && (
          isAdmin()
          || isAgentRecordAuthorized(get(/databases/$(database)/documents/agents/$(incoming().agentId)).data)
        );

      allow update: if isAdmin()
        && isValidId(payoutId)
        && isValidPayoutRequest(incoming(), payoutId)
        && incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().agentId == existing().agentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(payoutId);
    }

    // -------------------------------------------------------------------------
    // Collection 13: /vouchers/{voucherId} — Single-Use Offline Cash Vouchers
    // -------------------------------------------------------------------------
    match /vouchers/{voucherId} {
      allow get: if isVerifiedUser() && isValidId(voucherId);

      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || (resource.data.agentEmail is string && resource.data.agentEmail.size() >= 3 && resource.data.agentEmail == userEmailLower())
        );

      allow create: if isAdmin()
        && isValidId(voucherId)
        && isValidOfflineVoucher(incoming(), voucherId)
        && incoming().status == 'unused'
        && incoming().redeemedByUid == ''
        && incoming().redeemedByEmail == ''
        && incoming().redeemedAt == ''
        && incoming().createdAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(voucherId)
        && isValidOfflineVoucher(incoming(), voucherId)
        && existing().status == 'unused'
        && incoming().status == 'redeemed'
        && incoming().id == existing().id
        && incoming().code == existing().code
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().agentId == existing().agentId
        && incoming().agentEmail == existing().agentEmail
        && incoming().agentName == existing().agentName
        && incoming().planAmount == existing().planAmount
        && incoming().createdAt == existing().createdAt
        && incoming().redeemedByUid == request.auth.uid
        && incoming().redeemedByEmail == userEmailLower()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'redeemedByUid', 'redeemedByEmail', 'redeemedAt'
        ]);

      allow delete: if isAdmin() && isValidId(voucherId);
    }

    // -------------------------------------------------------------------------
    // Collection 14: /appConfig/{configId} — Daily Challenge & Announcements
    // -------------------------------------------------------------------------
    match /appConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;

      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidAppConfig(incoming(), configId)
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection 15: /practiceSessions/{sessionId} — Child Practice Sessions
    // -------------------------------------------------------------------------
    match /practiceSessions/{sessionId} {
      allow get: if isVerifiedUser()
        && isValidId(sessionId)
        && (resource == null || isFamilyScopedAuthorized(existing()));

      allow list: if isVerifiedUser()
        && isFamilyScopedAuthorized(resource.data);

      allow create: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidPracticeSession(incoming(), sessionId)
        && isFamilyScopedAuthorized(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/children/$(incoming().childId))
        && exists(/databases/$(database)/documents/parents/$(incoming().parentId))
        && (
          isAdmin()
          || isFamilyScopedAuthorized(get(/databases/$(database)/documents/children/$(incoming().childId)).data)
        );

      // Immutable historical practice log
      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(sessionId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }
  }
}
